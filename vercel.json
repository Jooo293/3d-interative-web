{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/start",
      "destination": "/start/index.html"
    },
    {
      "source": "/start/",
      "destination": "/start/index.html"
    },
    {
      "source": "/(about|gallery|studio|contact)",
      "destination": "/index.html"
    }
  ]
}
